[Unit]
Description=KurumiFRP local management workbench
Documentation=https://github.com/Presikid/KurumiFrp
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/opt/kurumifrp/meta/migrating

[Service]
Type=simple
User=kurumifrp
Group=kurumifrp
WorkingDirectory=/opt/kurumifrp/runtime
ExecStart=/opt/kurumifrp/kurumifrp
ExecStop=/opt/kurumifrp/kurumifrp --stop
KillMode=control-group
TimeoutStopSec=60
Restart=no
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/kurumifrp/runtime
CapabilityBoundingSet=
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
