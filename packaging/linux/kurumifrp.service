[Unit]
Description=KurumiFrp WebUI Controller (Bundled Official frpc/frps)
Documentation=https://github.com/Presikid/KurumiFrp
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kurumifrp
Group=kurumifrp
WorkingDirectory=/opt/kurumifrp
ExecStart=/opt/kurumifrp/kurumifrp -listen 0.0.0.0:9000 -data /opt/kurumifrp/data
ExecStop=/opt/kurumifrp/kurumifrp -stop -data /opt/kurumifrp/data
KillMode=control-group
TimeoutStopSec=30
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
